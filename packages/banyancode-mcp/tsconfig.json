{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "noEmit": true
  },
  "include": ["src"]
}
