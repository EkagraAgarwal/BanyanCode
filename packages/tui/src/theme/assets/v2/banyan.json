{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["green", "sky", "bark", "lime", "coral"],
    "text": {
      "base": "$hue.gray.200",
      "muted": "$hue.gray.400",
      "faint": "$hue.gray.500",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.gray.500",
          "$focused": "$background.base",
          "$selected": "$hue.green.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.surface.900",
          "$disabled": "$hue.gray.500"
        }
      },
      "formfield": {
        "base": "$hue.gray.200",
        "$hovered": "$hue.green.300",
        "$focused": "$hue.green.300",
        "$pressed": "$hue.green.300",
        "$disabled": "$hue.gray.500",
        "$selected": "$hue.green.300"
      },
      "feedback": {
        "error": {
          "base": "$hue.coral.300"
        },
        "warning": {
          "base": "$hue.amber.300"
        },
        "success": {
          "base": "$hue.green.300"
        },
        "info": {
          "base": "$hue.sky.300"
        }
      }
    },
    "background": {
      "base": "$hue.surface.700",
      "raised": {
        "base": "$hue.surface.600",
        "high": "$hue.surface.500",
        "max": "$hue.surface.400"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.surface.500",
          "$focused": "$hue.green.200",
          "$selected": "$hue.surface.400"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.surface.500"
        },
        "destructive": {
          "base": "$hue.coral.300",
          "$hovered": "$hue.coral.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.surface.300"
    },
    "scrollbar": {
      "base": "$hue.surface.200"
    },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.coral.300",
        "context": "$hue.gray.400",
        "hunkHeader": "$hue.sky.300"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.coral.800",
        "context": "$background.raised.base"
      },
      "highlight": {
        "added": "$hue.lime.300",
        "removed": "$hue.coral.200"
      },
      "lineNumber": {
        "text": "$hue.gray.500",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.coral.800"
        }
      }
    },
    "syntax": {
      "comment": "$hue.gray.500",
      "keyword": "$hue.green.300",
      "function": "$hue.sky.300",
      "variable": "$hue.coral.300",
      "string": "$hue.lime.300",
      "number": "$hue.amber.300",
      "type": "$hue.bark.300",
      "operator": "$hue.sky.200",
      "punctuation": "$hue.gray.400"
    },
    "markdown": {
      "text": "$hue.gray.200",
      "heading": "$hue.green.300",
      "link": "$hue.sky.300",
      "linkText": "$hue.sky.200",
      "code": "$hue.lime.300",
      "blockQuote": "$hue.bark.300",
      "emphasis": "$hue.bark.300",
      "strong": "$hue.amber.300",
      "horizontalRule": "$hue.gray.500",
      "listItem": "$hue.green.300",
      "listEnumeration": "$hue.amber.300",
      "image": "$hue.sky.300",
      "imageText": "$hue.sky.200",
      "codeBlock": "$hue.gray.200"
    },
    "growth": {
      "leaf": "$hue.green.300",
      "highlight": "$hue.lime.300",
      "done": "$hue.moss.300",
      "faded": "$hue.deep.300",
      "wood": "$hue.bark.300",
      "bright": "$hue.gray.100"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base"
      },
      "border": {
        "base": "$hue.surface.200"
      }
    }
  },
